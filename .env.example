# KEYSTONE Environment Configuration Template
# Copy this file to .env and update values for your environment

# ============= DATABASE CONFIGURATION =============
MYSQL_ROOT_PASSWORD=Bhoom@25
MYSQL_DATABASE=hr_emp_management
MYSQL_USER=hr_user
MYSQL_PASSWORD=SecurePassword123!

# ============= APPLICATION CONFIGURATION =============
# Port Configuration
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Database Connection (used by Spring Boot)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Bhoom@25
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/hr_emp_management

# ============= EMAIL CONFIGURATION =============
# Gmail SMTP Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Note: For Gmail, generate an App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select Mail and Windows Device
# 3. Copy the generated password

# ============= CLOUDINARY CONFIGURATION =============
# Cloud Storage for Photos
# Sign up at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============= LOGGING CONFIGURATION =============
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_SPRING_SECURITY=WARN
LOGGING_LEVEL_HIBERNATE=WARN

# ============= HIBERNATE CONFIGURATION =============
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=10

# ============= SESSION CONFIGURATION =============
SERVER_SERVLET_SESSION_TIMEOUT=30m
SERVER_SERVLET_SESSION_COOKIE_HTTPONLY=true
SERVER_SERVLET_SESSION_COOKIE_SECURE=false

# ============= DEPLOYMENT CONFIGURATION =============
# Docker Compose specific
COMPOSE_PROJECT_NAME=managebyhR
COMPOSE_FILE=docker-compose.yml

# MySQL Port mapping (external:internal)
MYSQL_PORT=3307:3306

# Application Port mapping
APP_PORT=8080:8080

# ============= SECURITY NOTES =============
# IMPORTANT: Keep this file secure and don't commit to version control
# For production, use strong passwords and secure vaults
# Example strong password: $(openssl rand -base64 32)
